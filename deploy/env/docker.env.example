# Docker-only environment — NOT used by local `php artisan serve`.
# Setup: cp deploy/env/docker.env.example deploy/env/docker.env
# Then edit deploy/env/docker.env (passwords, APP_KEY). Never commit docker.env.

APP_NAME="Cash Flow Summary"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=Africa/Douala

APP_LOCALE=en
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cashflow_summary
DB_USERNAME=cashflow_app
DB_PASSWORD=change-me-docker
DB_ROOT_PASSWORD=change-me-docker

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Queues via Horizon (required in Docker)
CSV_IMPORTS_SYNC=false
CSV_VERIFICATION_SYNC=false
REDIS_QUEUE_RETRY_AFTER=660

# Compose host port (nginx → browser). Change if 8080 is taken by another container.
HTTP_PORT=8081

# Seed users (local Docker only)
SEED_OWNER_USERNAME=owner
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=password

WHATSAPP_IMPORT_TEMPLATE=import_activity_summary
WHATSAPP_IMPORT_TEMPLATE_LANGUAGE=fr
