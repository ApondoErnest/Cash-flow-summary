# VPS / production environment (Steps 112–114)
# On the server only: cp deploy/env/production.env.example deploy/env/production.env
# Never use root .env or deploy/env/docker.env on the VPS.

APP_NAME="Cash Flow Summary"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cashflow.gsautobilan.com
APP_TIMEZONE=Africa/Douala

APP_LOCALE=en
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cashflow_summary
DB_USERNAME=cashflow_app
DB_PASSWORD=change-me-production
DB_ROOT_PASSWORD=change-me-production

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gsautobilan.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Queues via Horizon (required)
CSV_IMPORTS_SYNC=false
CSV_VERIFICATION_SYNC=false
CSV_VERIFICATION_JOB_TIMEOUT=600
CSV_IMPORTS_JOB_TIMEOUT=600
REDIS_QUEUE_RETRY_AFTER=660

# Production security (Step 102) — enabled when APP_ENV=production
PRODUCTION_SECURITY_ENABLED=true
FORCE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=true

# Host port — bind localhost only in production (see docker-compose.production.yml).
# Use 8081 when another app (e.g. gs-autobilan) already uses 127.0.0.1:8080.
HTTP_PORT=8081

# Do not seed production — remove or leave blank
# SEED_OWNER_USERNAME=
# SEED_OWNER_PASSWORD=

WHATSAPP_IMPORT_TEMPLATE=import_activity_summary
WHATSAPP_IMPORT_TEMPLATE_LANGUAGE=fr

# WHATSAPP_APP_SECRET=   # webhook signature verification (production)
