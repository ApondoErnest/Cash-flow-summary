# Cash Flow Summary — monitoring + alerts (Step 116)
# On the VPS: cp deploy/env/monitor.env.example deploy/env/monitor.env
# Never commit deploy/env/monitor.env

# Health checks
MONITOR_PUBLIC_URL=https://cashflow.gsautobilan.com
MONITOR_LOCAL_URL=http://127.0.0.1:8081

# Alert when /up has been failing for this many minutes (backup-monitoring.md)
UPTIME_ALERT_MINUTES=2

# Minimum time between duplicate alert messages for the same issue
ALERT_COOLDOWN_MINUTES=30

# Thresholds
DISK_WARN_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
QUEUE_BACKLOG_WARN=100
TLS_WARN_DAYS=14
REDIS_MEMORY_WARN_PERCENT=80

# Alert destinations (set at least one on the VPS)
# ALERT_EMAIL=ops@example.com
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Send a recovery message when checks pass again after an alert
ALERT_ON_OK=true

# State + logs
STATE_DIR=/var/lib/cashflow-summary
# LOG_TAG is fixed in the script: cashflow-summary-monitor
