# VPS / production environment template (Steps 112–114).
# Copy on the server only — e.g. deploy/env/production.env — never use root .env or docker.env.
# Same isolation principle as deploy/env/docker.env for local Docker.

APP_NAME="Cash Flow Summary"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Africa/Douala

# ... mirror remaining keys from docker.env.example with production values ...
# DB_HOST=mysql
# REDIS_HOST=redis
# FORCE_HTTPS=true
# TRUSTED_PROXIES=*

