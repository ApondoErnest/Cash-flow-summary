# Cash Flow Summary — backup settings (Step 115)
# On the VPS: cp deploy/env/backup.env.example deploy/env/backup.env
# Never commit deploy/env/backup.env

# Local backup root (mode 700 recommended)
BACKUP_ROOT=/var/backups/cashflow-summary

# Docker storage volume name (default matches docker-compose.yml)
# STORAGE_VOLUME=cashflow-summary_storage_data

# Local VPS retention — default keeps ~4 weeks, then auto-deletes older runs.
# This avoids filling disk with duplicate weekly/monthly copies on the server.
RETENTION_DAILY=28
RETENTION_WEEKLY=0
RETENTION_MONTHLY=0

# Long-term tiers (enable only when syncing to off-server storage):
# RETENTION_WEEKLY=4
# RETENTION_MONTHLY=12

# Off-site sync (optional) — rsync over SSH example:
# BACKUP_OFFSITE_RSYNC_DEST=backup@backup-server.example:/backups/cashflow-summary/
# BACKUP_OFFSITE_RSYNC_DEST=

# Encrypt production.env snapshot before off-site sync (optional)
# BACKUP_GPG_RECIPIENT=ops@example.com
